# Local development defaults. Never commit your real .env file.
DJANGO_SECRET_KEY=replace-this-with-a-unique-random-secret-of-at-least-50-characters
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
# Optional: set DATABASE_URL only when you want to use PostgreSQL locally.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
